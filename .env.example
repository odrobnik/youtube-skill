# Environment variables read by scripts/youtube.py. They override the values in
# config.json (see SETUP.md for where that file lives).
#
# The script reads the environment, not this file. Copy it to .env (git-ignored),
# fill it in, and load it into your shell or agent environment, for example:
#   set -a; . ./.env; set +a

# YouTube Data API v3 key: enough for search, no sign-in needed
YOUTUBE_API_KEY=

# OAuth client (Desktop app) for managing playlists, followed by a one-time `auth`
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Optional: another folder for config.json and the stored sign-in
# (default: $OPENCLAW_STATE_DIR/youtube if set, else ~/.openclaw/youtube)
# YOUTUBE_SKILL_CONFIG_DIR=
